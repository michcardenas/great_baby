# =========================================================
# .env DE PRODUCCIÓN · GREAT BABY ERP
# Copiá este archivo como .env en el servidor y llenalo con
# los datos reales. NO lo commitees.
# =========================================================

APP_NAME="GREAT BABY ERP"
APP_ENV=production
APP_KEY=                                    # genera con: php artisan key:generate
APP_DEBUG=false                             # NUNCA true en producción
APP_URL=https://erp.greatbaby.com.co        # dominio real con https
APP_TIMEZONE=America/Bogota
APP_LOCALE=es
APP_FALLBACK_LOCALE=es

# ---------- Base de datos ----------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=greatbaby_prod
DB_USERNAME=greatbaby_user
DB_PASSWORD=                                # password fuerte, único

# ---------- Sesión & caché ----------
SESSION_DRIVER=database                     # requiere `sessions` table (php artisan session:table + migrate)
SESSION_LIFETIME=480                        # 8 horas
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true                  # forzado con https
SESSION_SAME_SITE=lax
CACHE_STORE=file                            # o redis si Hostinger lo permite

# ---------- Cola ----------
QUEUE_CONNECTION=database                   # requiere tabla `jobs`
# Con supervisor/cron corriendo:
# * * * * * cd /var/www/greatbaby-erp && php artisan schedule:run >> /dev/null 2>&1
# php artisan queue:work --sleep=3 --tries=3 --max-time=3600

# ---------- Correo (obligatorio para portal B2B y facturación) ----------
MAIL_MAILER=smtp
MAIL_HOST=smtp.hostinger.com                # o smtp.gmail.com, smtp.mailgun.org, etc
MAIL_PORT=465
MAIL_USERNAME=notificaciones@greatbaby.com.co
MAIL_PASSWORD=                              # password del email
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=notificaciones@greatbaby.com.co
MAIL_FROM_NAME="GREAT BABY"

# ---------- SIIGO (opcional, si Aracely quiere sincronizar) ----------
SIIGO_URL=https://api.siigo.com
SIIGO_USER=
SIIGO_ACCESS_KEY=
SIIGO_PARTNER_ID=

# ---------- Facturación electrónica DIAN (por resolución) ----------
# El sistema usa el emisor propio; llenar en /app/empresa (WYSIWYG).

# ---------- WhatsApp cloud API (Cobranza automática) ----------
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=

# ---------- Backup S3 (opcional) ----------
BACKUP_S3_KEY=
BACKUP_S3_SECRET=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=us-east-1

# ---------- Logs ----------
LOG_CHANNEL=daily
LOG_LEVEL=warning                           # info -> genera mucho; en prod: warning o error

# ---------- Seguridad ----------
BCRYPT_ROUNDS=12                            # NO bajes esto
