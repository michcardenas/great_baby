APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# =========================================================================
# MAIL — En LOCAL usar `log` (revisar storage/logs/laravel.log).
# En PRODUCCIÓN usar `smtp` con credenciales reales; si queda en `log` el
# cliente NUNCA recibe la factura DIAN (Mail::queue solo escribe al log).
# =========================================================================
MAIL_MAILER=log
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com | smtp.mailgun.org | ...
# MAIL_PORT=587
# MAIL_USERNAME=your-user@dominio.com
# MAIL_PASSWORD="app_password_16_chars"
# MAIL_SCHEME=tls
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# =========================================================================
# QUEUE — En LOCAL `database` funciona sin worker (usa driver sync effectivo
# para dispatch->delay). En PRODUCCIÓN correr `php artisan queue:work` como
# servicio supervisor/systemd para que los emails salgan y los reintentos
# de DIAN se ejecuten con backoff. Ver docs/deploy.md.
# =========================================================================
# QUEUE_CONNECTION=database  (ver .env activo)

# =========================================================================
# WHATSAPP CLOUD API — driver `mock` sólo loguea. Para envío REAL de cobranza:
# =========================================================================
WHATSAPP_DRIVER=mock
# WHATSAPP_TOKEN=EAAyyyyy   (permanent token de Meta Cloud API)
# WHATSAPP_PHONE_ID=1234567890
# WHATSAPP_TEMPLATE_DESPACHO=pedido_despachado_v1

# =========================================================================
# SIIGO API — credenciales que Aracely obtiene desde su Siigo Cloud.
# En Configuración → Integración SIIGO se guardan encriptadas.
# =========================================================================
# SIIGO_BASE_URL=https://api.siigo.com/v1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
