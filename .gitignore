# GREAT BABY — datos operativos que no van al repo
/storage/app/private/empaques/*
!/storage/app/private/empaques/.gitkeep
/storage/app/backups/*
!/storage/app/backups/.gitkeep
/storage/app/public/empresa/*
!/storage/app/public/empresa/.gitkeep
/public/uploads/*
!/public/uploads/.gitkeep

# Logs, caches y scratchpad
/storage/logs/*
!/storage/logs/.gitkeep
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore

