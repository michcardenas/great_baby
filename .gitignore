*.log
.DS_Store
.env
.env.backup
.env.production
# Cualquier otra copia del .env: una llamada `.env.backup-recuperacion`
# con APP_KEY, DB_PASSWORD y las de AWS estuvo a un `git add -A` de
# subir al repo publico el 2026-10-09.
.env.*
!.env.example
.phpactor.json
.phpunit.result.cache
/.fleet
/.idea
/.nova
/.phpunit.cache
/.vscode
/.zed
/auth.json
/node_modules
# /public/build  ← se trackea en repo para que el inge solo haga `git pull` sin correr npm run build en Hostinger
/public/hot
/public/storage
/storage/*.key
/storage/pail
/vendor
Homestead.json
Homestead.yaml
Thumbs.db

# GREAT BABY — datos operativos que no van al repo
/storage/app/private/empaques/*
!/storage/app/private/empaques/.gitkeep
/storage/app/backups/*
!/storage/app/backups/.gitkeep
/storage/app/public/empresa/*
!/storage/app/public/empresa/.gitkeep
/public/uploads/*
!/public/uploads/.gitkeep

# Logs, caches y scratchpad
/storage/logs/*
!/storage/logs/.gitkeep
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore

# Windows/OSX cruft
desktop.ini
*.tmp

